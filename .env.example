# VARIÁVEIS DA VERCEL (Project → Settings → Environment Variables)
# Estes valores são exemplos. NUNCA coloques chaves reais no GitHub.

# --- Supabase (Project Settings → API Keys) ---
SUPABASE_URL=https://teu-projeto.supabase.co
SUPABASE_PUBLISHABLE_KEY=sb_publishable_xxxxxxxx      # chave PÚBLICA (pode ir ao navegador)
SUPABASE_SECRET_KEY=sb_secret_xxxxxxxx                # chave SECRETA (só servidor; nunca no GitHub)

# --- OpenAI (platform.openai.com → API keys) ---
OPENAI_API_KEY=sk-xxxxxxxx
OPENAI_MODEL=gpt-4.1-mini                             # opcional
OPENAI_IMAGE_MODEL=gpt-image-1                        # opcional (alternativa: dall-e-3)
OPENAI_IMAGE_QUALITY=low                              # opcional: low | medium | high (mais qualidade = mais custo)
