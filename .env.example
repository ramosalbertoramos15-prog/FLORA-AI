# Ambiente Vercel — usa variáveis de ambiente, nunca coloques chaves privadas em código do navegador.
# A URL e a chave PÚBLICA do Supabase são devolvidas ao navegador em /api/public-config.
SUPABASE_URL=https://teu-projeto.supabase.co
SUPABASE_PUBLISHABLE_KEY=sb_publishable_coloca_aqui_a_chave_publica
# Alternativa em projetos antigos: SUPABASE_ANON_KEY (anon/public, NUNCA service_role)

# Beta de IA (o código é obrigatório MESMO após iniciar sessão)
OPENAI_API_KEY=coloca_aqui_a_tua_chave_privada
FLORA_AI_ACCESS_CODE=gera_um_codigo_longo_aleatorio_so_para_testadores
OPENAI_MODEL=gpt-4.1-mini
